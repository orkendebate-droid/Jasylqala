# -----------------------------------------------------------------------------
# Jasylqala Environment Configuration Example
# Скопируйте этот файл в .env и укажите свои значения:
# -----------------------------------------------------------------------------

# База данных PostgreSQL (с расширением PostGIS)
# Для Supabase:
# DATABASE_URL=postgresql+psycopg://postgres:[YOUR-DB-PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres
# Для локального Docker:
# DATABASE_URL=postgresql+psycopg://jasylqala:jasylqala_dev_password@localhost:5432/jasylqala
DATABASE_URL=sqlite:///./jasylqala.db

# Разрешённые CORS-источники фронтенда (через запятую)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Supabase Storage (для сохранения фото деревьев на Render)
SUPABASE_URL=https://[PROJECT-ID].supabase.co
SUPABASE_KEY=sb_secret_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_BUCKET=tree-photos

# URL бэкенда для фронтенда (Vite)
VITE_API_URL=https://jasylqala-api.onrender.com
